{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "env.d.ts",
    "plugins/**/*.ts",
    "plugins/**/*.mts",
    "plugins/**/*.js",
    "plugins/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".build",
    "dist"
  ]
}
