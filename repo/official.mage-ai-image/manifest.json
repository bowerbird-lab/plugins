{
  "id": "official.mage-ai-image",
  "name": "Mage AI Image",
  "version": "1.0.1-dev.0",
  "minAppVersion": "1.0.0",
  "kind": "action",
  "description": "Edit images with Mage API v1 models directly from the inspector or a standalone studio window.",
  "author": "Bowerbird Team",
  "license": "MIT",
  "priority": 60,
  "extensions": [
    "png",
    "jpg",
    "jpeg",
    "webp"
  ],
  "mimePrefixes": [
    "image/"
  ],
  "builtin": false,
  "capabilities": [
    "ai-image-edit",
    "standalone-window",
    "inspector-panel",
    "actions"
  ],
  "ui": {
    "windows": [
      {
        "id": "studio",
        "title": "Mage AI Image Studio",
        "entry": "ui/index.html"
      }
    ],
    "inspector": [
      {
        "id": "edit-image",
        "type": "window",
        "title": "用 Mage 修图",
        "window": "studio"
      }
    ]
  },
  "permissions": {
    "assets": [
      "read",
      "write"
    ],
    "network": [
      "api.mage.space",
      "*.mage.space",
      "storage.googleapis.com"
    ],
    "process": [],
    "openExternal": true
  },
  "settings": [
    {
      "key": "apiKey",
      "label": "Mage API Key",
      "help": "Create an API key at mage.space/api (API Keys tab).",
      "placeholder": "mage_sk_...",
      "secret": true
    },
    {
      "key": "defaultArchitecture",
      "label": "Default Model",
      "help": "Default Mage architecture for image editing (e.g. flux2, gpt_image_2, mango, nano_banana_v2).",
      "placeholder": "flux2",
      "default": "flux2"
    }
  ],
  "homepage": "https://docs.mage.space/api/overview",
  "platforms": [
    "desktop"
  ]
}
